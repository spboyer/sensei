---
const installCommand = 'npx skills add spboyer/sensei';
const examples = [
  {
    command: 'Run sensei on my-skill-name',
    description: 'Improve one skill from Copilot CLI',
  },
  {
    command: 'npx @spboyer/sensei score .',
    description: 'Score a skill directory without cloning Sensei',
  },
  {
    command: 'npx @spboyer/sensei check --root . --strict',
    description: 'Run token validation in any project',
  },
  {
    command: 'npm run tokens -- score . --root=/path/to/project --emit-proof',
    description: 'Current source: report repo policy and write a static audit artifact',
  },
  {
    command: "import { parseFrontmatter } from '@spboyer/sensei/parse';",
    description: 'Use granular library exports in your own tooling',
  },
];
---

<section class="py-24 md:py-32 px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-light-gray">
      Quick Start
    </h2>
    <p class="mt-4 text-mid-gray text-lg max-w-2xl">
      Install it as a skill, run it with npx, wire it into CI, or import the parts you need.
    </p>
    <p class="mt-4 text-mid-gray max-w-2xl">
      For newly merged YAML validation, proof/policy, and evaluation features,
      clone the current source and run <code>npm ci --prefix scripts</code>.
      Source commands below run from that checkout; <code>--root</code> selects your project.
      Published npm and Action tags may lag
      <a class="text-orange-accent" href="https://github.com/spboyer/sensei/blob/main/README.md#distribution-and-release-status">release status</a>.
      The Action runs npm, not the CLI from its own checkout.
    </p>
    <p class="mt-4 text-mid-gray max-w-2xl">
      A shared SKILL.md does not guarantee shared installation, invocation controls,
      or permissions. See the
      <a class="text-orange-accent" href="https://github.com/spboyer/sensei/blob/main/references/portability.md">host portability matrix</a>
      for Claude Code extensions, OpenAI sidecars/API bundles, and Copilot locations.
      Local personal skills are not automatically available in cloud sessions.
      Static scoring is not observed activation or a security audit.
    </p>
    <div class="mt-12">
      <div class="inline-flex items-center bg-dark-gray border border-mid-gray/20 font-mono text-base">
        <code id="qs-install-cmd" class="px-6 py-4 text-light-gray select-all">{installCommand}</code>
        <button
          id="qs-copy-btn"
          class="px-5 py-4 border-l border-mid-gray/20 text-mid-gray hover:text-orange-accent transition-colors cursor-pointer"
          aria-label="Copy install command"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="0" ry="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        </button>
      </div>
    </div>
    <div class="mt-16 space-y-4">
      {examples.map((ex) => (
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6">
          <code class="bg-dark-gray px-5 py-3 font-mono text-sm text-light-gray min-w-0 overflow-x-auto">
            {ex.command}
          </code>
          <span class="text-sm text-mid-gray">{ex.description}</span>
        </div>
      ))}
    </div>
    <div class="mt-12 text-mid-gray max-w-2xl">
      <h3 class="text-lg font-semibold text-light-gray">Commit-pinned source bundles</h3>
      <p class="mt-2 leading-relaxed">
        Actions artifacts include <code>sensei.tar.gz</code>, <code>source.json</code>,
        and <code>SHA256SUMS</code> for an exact source commit, retained for 30 days.
        They require authenticated downloads, contain no installed dependencies or compiled CLI,
        and do not automatically update downstream dotfiles.
        Checksums are not signed attestations. See the
        <a class="text-orange-accent" href="https://github.com/spboyer/sensei/blob/main/references/distribution.md">bundle contract</a>.
      </p>
    </div>
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-px bg-mid-gray/10">
      <div class="bg-dark-gray p-6">
        <h3 class="text-lg font-semibold text-light-gray">GitHub Action</h3>
        <p class="mt-2 text-sm text-mid-gray leading-relaxed">
          Add <code class="text-light-gray">spboyer/sensei@v1.5.0</code> to CI and run <code class="text-light-gray">check</code> on pull requests.
        </p>
      </div>
      <div class="bg-dark-gray p-6">
        <h3 class="text-lg font-semibold text-light-gray">External roots</h3>
        <p class="mt-2 text-sm text-mid-gray leading-relaxed">
          Use <code class="text-light-gray">--root</code> and <code class="text-light-gray">--config</code> to validate skills from another project directory.
        </p>
      </div>
      <div class="bg-dark-gray p-6">
        <h3 class="text-lg font-semibold text-light-gray">Library exports</h3>
        <p class="mt-2 text-sm text-mid-gray leading-relaxed">
          Import <code class="text-light-gray">/score</code>, <code class="text-light-gray">/parse</code>, or <code class="text-light-gray">/checks</code> without pulling in the CLI.
        </p>
      </div>
    </div>
    <div class="mt-12">
      <a
        href="https://github.com/spboyer/sensei"
        class="text-sm text-mid-gray hover:text-orange-accent transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        Full documentation on GitHub →
      </a>
    </div>
  </div>
</section>

<script>
  const qsBtn = document.getElementById('qs-copy-btn');
  const qsCmd = document.getElementById('qs-install-cmd');
  if (qsBtn && qsCmd) {
    qsBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(qsCmd.textContent?.trim() ?? '');
        qsBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        setTimeout(() => {
          qsBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="0" ry="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
        }, 2000);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(qsCmd);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
      }
    });
  }
</script>
