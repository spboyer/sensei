---
const problems = [
  {
    title: 'No triggers',
    description: 'Agent doesn\'t know when to activate the skill.',
  },
  {
    title: 'Ambiguous scope',
    description: 'Agent doesn\'t know when NOT to use the skill.',
  },
  {
    title: 'Vague descriptions',
    description: 'Length alone does not establish useful scope.',
  },
  {
    title: 'Broken resources',
    description: 'Missing, escaping, or deeply chained references break progressive disclosure.',
  },
  {
    title: 'Unproven behavior',
    description: 'Clean prose does not establish activation, task quality, or improvement.',
  },
  {
    title: 'Hidden risk',
    description: 'Scripts, permissions, dependencies, and release state need separate evidence.',
  },
];
---

<section class="py-24 md:py-32 px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-light-gray">
      Valid Frontmatter Is Only the Beginning
    </h2>
    <p class="mt-4 text-mid-gray text-lg max-w-2xl">
      Skill quality spans routing, resources, runtime behavior, trust boundaries,
      and maintenance. One static score cannot prove all of them.
    </p>
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
      {problems.map((p) => (
        <div class="bg-dark-gray border-l-2 border-orange-accent p-6">
          <h3 class="text-lg font-semibold text-light-gray">{p.title}</h3>
          <p class="mt-2 text-mid-gray text-sm leading-relaxed">{p.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
