---
const links = [
  { label: 'GitHub', href: 'https://github.com/spboyer/sensei' },
  { label: 'License (MIT)', href: 'https://github.com/spboyer/sensei/blob/main/LICENSE.txt' },
  { label: 'Ralph Loop', href: 'https://github.com/spboyer/sensei/blob/main/references/loop.md' },
  { label: 'Agent Skills Specification', href: 'https://agentskills.io/specification' },
  { label: 'Distribution', href: 'https://github.com/spboyer/sensei/blob/main/references/distribution.md' },
  { label: 'Host Portability', href: 'https://github.com/spboyer/sensei/blob/main/references/portability.md' },
];
---

<footer class="border-t border-mid-gray/20 py-12 px-6">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <nav class="flex flex-wrap gap-x-6 gap-y-2">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-mid-gray hover:text-light-gray transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <p class="text-xs text-mid-gray/60">
      Sensei 🥋
    </p>
  </div>
</footer>
